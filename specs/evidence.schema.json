{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopegate.example.test/specs/evidence.schema.json",
  "title": "Scopegate implementation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "gates", "scenarios", "tasks", "live_approvals"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"},
    "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}},
    "scenarios": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "gate_ids", "artifact"], "properties": {"id": {"type": "string", "pattern": "^F[0-9]{2}-AC-[0-9]{2}$"}, "gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "artifact": {"$ref": "#/$defs/artifact"}}}},
    "tasks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "scenario_ids", "artifact"], "properties": {"id": {"type": "string", "pattern": "^T[0-9]{2}$"}, "status": {"enum": ["complete", "failed", "blocked"]}, "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "artifact": {"$ref": "#/$defs/artifact"}}}},
    "live_approvals": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "owner", "revision", "artifact"], "properties": {"id": {"enum": ["identity-provider", "notification-provider", "all-writers-fenced", "all-consumers-enforced", "intended-access-baseline", "zero-unexplained-divergence", "durable-manager-policy", "restore-reconciliation", "cohort-observation", "legacy-contraction"]}, "owner": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"}, "artifact": {"$ref": "#/$defs/artifact"}}}}
  },
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["id", "scope", "status", "command", "exit_code", "revision", "started_at", "finished_at", "environment", "artifacts"], "properties": {
      "id": {"type": "string", "pattern": "^G-[A-Z]+$"},
      "scope": {"enum": ["synthetic", "live"]},
      "status": {"enum": ["passed", "failed", "blocked", "skipped"]},
      "command": {"type": "string", "minLength": 1},
      "exit_code": {"type": ["integer", "null"]},
      "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
      "started_at": {"type": "string", "format": "date-time"},
      "finished_at": {"type": "string", "format": "date-time"},
      "environment": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
      "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
    }}
  }
}
