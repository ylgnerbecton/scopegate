  "workload_mix_percent": {"bounded_reads": 65, "scoped_search": 15, "access_mutations": 10, "protected_use": 5, "identity_and_operations": 5},
  "mutation_mix_percent_of_all_requests": {"grants_and_membership": 7, "invitations": 2, "entitlement_disable": 1},
  "concurrency_examples": {
    "formula": "mean_in_flight = arrival_per_second * mean_residence_milliseconds / 1000",
    "ordinary_mean_in_flight": 2.5,
    "peak_mean_in_flight": 10.0,
    "burst_mean_in_flight": 40.0,
    "peak_mean_database_occupancy": 3.2,
    "burst_mean_database_occupancy": 12.8,
    "p95_is_not_mean": true,
    "steady_interval_assumption": true,
    "slow_dependency_example": {"arrival_per_second": 40, "mean_residence_milliseconds": 2000, "mean_in_flight": 80, "result": "exceeds proposed active limit; bounded admission rejects safely"}
  },
  "connection_budget": {
    "http_formula": "http_replicas * http_workers_per_replica * (http_pool_size + http_pool_overflow)",
    "outbox_formula": "outbox_workers * (outbox_pool_size + outbox_pool_overflow)",
    "allocation_formula": "http_connections + outbox_connections + operations_connection_allocation <= application_connection_allocation",
    "engine_formula": "application_connection_allocation + database_connection_reserve <= database_max_connections",
    "proposed_http_connections": 20,
    "proposed_outbox_connections": 4,
    "proposed_application_and_operations_use": 32,
    "proposed_allocation": 40,
    "proposed_unused_allocation": 8,
    "proposed_use_plus_reserve": 52,
    "third_http_replica_use": 42,
    "third_http_replica_use_plus_reserve": 62,
    "count_draining_workers_and_release_jobs": true,
    "multiple_role_engines_share_total_worker_allocation": true,
    "replacement_requires_old_pool_disposal": true,
    "unbounded_pool_overflow": false,
    "increase_requires_reapproved_memory_and_rollout_budget": true
  },
  "endpoint_budgets": [
    {"class": "organization_project_lists", "p95_milliseconds": 250, "maximum_application_sql_statements": 5, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "membership_grant_pages", "p95_milliseconds": 300, "maximum_application_sql_statements": 6, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "scoped_search_localization", "p95_milliseconds": 350, "maximum_application_sql_statements": 6, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "invitation_creation_resend", "p95_milliseconds": 500, "maximum_application_sql_statements": 12, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "grant_membership_mutation", "p95_milliseconds": 500, "maximum_application_sql_statements": 12, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "entitlement_disable", "p95_milliseconds": 750, "maximum_application_sql_statements": 16, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "invitation_preview_acceptance", "p95_milliseconds": 500, "maximum_application_sql_statements": 12, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "protected_report_admission", "p95_milliseconds": 500, "maximum_application_sql_statements": 10, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "identity_callback", "p95_milliseconds": 2500, "maximum_application_sql_statements": 8, "owner": "identity_owner", "evidence_gate": "G-PERFORMANCE"},
    {"class": "audit_migration_review_pages", "p95_milliseconds": 350, "maximum_application_sql_statements": 6, "owner": "backend_owner", "evidence_gate": "G-PERFORMANCE"}
  ],
  "query_protocol": {
    "authorization_before_pagination_and_counts": true,
    "pagination": "keyset",
    "stable_uuid_tiebreaker": true,
    "cursor_scope": ["principal", "organization", "project", "view", "locale", "query", "sort", "relevant_access_version"],
    "changed_access_version": "refresh conflict; no mixed-version pages",
    "n_plus_one_allowed": false,
    "query_count_test_pages": [1, 25, 100],
    "plan_command": "EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON)",
    "mutation_plan_environment": "disposable database or explicit rollback",
    "record": ["actual_and_estimated_rows", "loops", "rows_removed", "shared_hits", "shared_reads", "temporary_spill", "execution_time", "lock_wait", "statistics_revision"],
    "trigram_index": "deferred pending measured substring query plan, deployment support, write and storage cost",
    "entitlement_preview_preconditions": ["same organization and project", "current revision", "deterministic impact fingerprint", "recomputed caps under canonical locks"],
    "above_impact_cap": "409 with no access or invitation writes"
  },
  "cache_and_replica_policy": {
    "static_assets": "immutable versioned assets; CDN via selected host adapter",
    "catalog_cache_key": ["resource_version", "locale"],
    "catalog_metadata_after_current_policy_only": true,
    "publication_or_archive_invalidates_metadata": true,
    "authorization_cache": false,
    "session_membership_entitlement_grant_mode_cache": false,
    "authorization_read_source": "primary",
    "initial_replica_count": 0,
    "future_replica_scope": "explicitly nonauthorizing analytics or presentation with approved lag and exposure policy",
    "frontend_state_is_authority": false
  },
  "scenarios": [
    {"id": "CAP-STEADY", "warmup_seconds": 900, "measurement_seconds": 1800, "arrival_per_second": 40, "bad_fraction_maximum": 0.001, "purpose": "endpoint budgets and bounded pools"},
    {"id": "CAP-BURST", "burst_seconds": 60, "arrival_per_second": 160, "recovery_observation_seconds": 600, "recovery_target_seconds": 120, "purpose": "bounded overload without state loss"},
    {"id": "CAP-HOT-TENANT", "measurement_seconds": 1800, "arrival_per_second": 40, "grant_workload_hot_share": 0.5, "purpose": "contention and unrelated organization responsiveness"},
    {"id": "CAP-REVOKE-USE", "measurement_seconds": 600, "purpose": "canonical transaction ordering during load"},
    {"id": "CAP-IMPACT-BOUND", "cases": ["at each impact cap", "one over each impact cap", "preview fingerprint changed", "preview revision stale"], "purpose": "atomic bounded entitlement disable"},
    {"id": "CAP-STRESS", "arrival_step_per_second": 20, "maximum_step_seconds": 300, "purpose": "identify first saturation resource; stop after controlled failure evidence"},
    {"id": "CAP-SOAK", "measurement_seconds": 7200, "arrival_per_second": 40, "purpose": "memory pool outbox and purge stability"},
    {"id": "CAP-DEGRADED", "cases": ["slow provider", "unavailable delivery", "exhausted database pool"], "purpose": "safe deadlines and no multiplied retries"}
  ],
  "scaling_decisions": [
    {"candidate": "more HTTP capacity", "trigger": "CPU over 70 percent plus missed p95 across three measured peak windows", "requires": ["application profiling", "low database contention", "new connection and rollout overlap budget"], "implement_now": false},
    {"candidate": "database vertical capacity", "trigger": "proven efficient queries constrained by CPU memory or IO", "requires": ["query and lock review", "cost", "backup and restore rehearsal"], "implement_now": false},
    {"candidate": "more outbox workers", "trigger": "due age beyond five minutes with healthy provider and measured claim throughput limit", "requires": ["provider quota", "lease safety", "new DB allocation", "duplicate delivery test"], "implement_now": false},
    {"candidate": "read replica", "trigger": "nonauthorizing analytics measurably harms primary", "requires": ["consistency classification", "lag visibility", "no stale authorization"], "implement_now": false},
    {"candidate": "audit partitioning", "trigger": "measured retention vacuum or maintenance issue; initial review at ten million events", "requires": ["partition aware relationships", "pruning", "retention approval", "restore rehearsal"], "implement_now": false},
    {"candidate": "external broker", "trigger": "measured outbox limit or independently owned consumers", "requires": ["delivery and inbox semantics", "operating owner", "migration cost"], "implement_now": false},
    {"candidate": "tenant shard", "trigger": "single primary writes or contractual isolation cannot be met through simpler changes", "requires": ["placement and global identity/catalog RFC", "fencing", "recovery", "workflow review"], "implement_now": false}
  ],
  "canary": {
    "unit": "whole approved organization",
    "percentages": [5, 25, 100],
    "selection": "ceil(eligible_count * percentage / 100), minimum one, limited to eligible count",
    "minimum_observation_hours": [24, 48, 72],
    "normal_operating_and_job_cycle_required": true,
    "random_per_request_split": false,
    "unapproved_organization_eligible": false,
    "target_authority_preserved": true,
    "owner": "platform_owner"
  },
  "validation_rules": [
    "all numeric parameter values are inside their declared inclusive ranges",
    "workload_mix_percent sums to 100 and mutation submix sums to access_mutations",
    "mean concurrency calculations use mean, not p95",
    "HTTP and outbox connection formulas equal declared example values",
    "application and operations use <= allocation; allocation + reserve <= database maximum",
    "backfill connection allocation is included in operations allocation, never added twice",
    "draining and replacement worker pools count during deployment",
    "default_page <= maximum_page <= canonical API maximum",
    "grant_additions + grant_removals <= changed_grant_response",
    "all endpoint p95 budgets are below their applicable absolute request deadline",
    "query count cannot grow per returned row",
    "authorization cache or replica allow is prohibited",
    "scaling trigger initiates review, not automatic infrastructure installation",
    "missing load generator capacity or missing host evidence blocks result certification"
  ],
  "live_input_gates": ["actual endpoint distribution", "busy hour and job cycle", "host CPU memory and connection reserve", "data and WAL growth", "provider quotas", "retention", "approved objectives and observation windows"],
  "evidence_gates": ["G-CONTRACT", "G-DATABASE", "G-PERFORMANCE", "G-SECURITY", "G-OPERATIONS", "G-MIGRATION", "G-RELEASE"]
}
