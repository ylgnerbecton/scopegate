{
  "schema_version": 1,
  "project": "Scopegate",
  "contract_type": "resilience_configuration",
  "status": "proposed",
  "implemented": false,
  "approval_scope": "synthetic implementation; live values require reviewed evidence",
  "owners": ["engineering_lead", "platform_owner", "identity_owner", "delivery_owner", "security_owner"],
  "canonical_documents": ["docs/RELIABILITY_DESIGN.md", "docs/DELIVERY_SYSTEM.md", "docs/SECURITY.md", "docs/MIGRATION.md"],
  "parameters": {
    "http_deadline": {"value": 2000, "unit": "milliseconds", "minimum": 500, "maximum": 5000, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS"},
    "identity_callback_deadline": {"value": 5000, "unit": "milliseconds", "minimum": 1000, "maximum": 10000, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "http_response_reserve": {"value": 150, "unit": "milliseconds", "minimum": 50, "maximum": 500, "owner": "engineering_lead", "evidence_gate": "G-OPERATIONS"},
    "admission_wait": {"value": 50, "unit": "milliseconds", "minimum": 0, "maximum": 250, "owner": "platform_owner", "evidence_gate": "G-PERFORMANCE"},
    "admission_waiting_per_worker": {"value": 8, "unit": "requests", "minimum": 0, "maximum": 16, "owner": "platform_owner", "evidence_gate": "G-PERFORMANCE"},
    "http_active_per_worker": {"value": 16, "unit": "requests", "minimum": 1, "maximum": 32, "owner": "platform_owner", "evidence_gate": "G-PERFORMANCE"},
    "pool_checkout_wait": {"value": 100, "unit": "milliseconds", "minimum": 10, "maximum": 500, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS"},
    "database_connect": {"value": 1000, "unit": "milliseconds", "minimum": 100, "maximum": 3000, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS"},
    "database_lock": {"value": 250, "unit": "milliseconds", "minimum": 10, "maximum": 1000, "owner": "engineering_lead", "evidence_gate": "G-DATABASE"},
    "database_statement": {"value": 750, "unit": "milliseconds", "minimum": 50, "maximum": 1500, "owner": "engineering_lead", "evidence_gate": "G-DATABASE"},
    "database_transaction": {"value": 1200, "unit": "milliseconds", "minimum": 100, "maximum": 1850, "owner": "engineering_lead", "evidence_gate": "G-DATABASE"},
    "backfill_transaction": {"value": 2000, "unit": "milliseconds", "minimum": 250, "maximum": 5000, "owner": "platform_owner", "evidence_gate": "G-MIGRATION"},
    "oidc_connect": {"value": 500, "unit": "milliseconds", "minimum": 100, "maximum": 1000, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "oidc_read": {"value": 1500, "unit": "milliseconds", "minimum": 250, "maximum": 3000, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "oidc_exchange": {"value": 2000, "unit": "milliseconds", "minimum": 500, "maximum": 4000, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "oidc_calls_per_http_worker": {"value": 2, "unit": "calls", "minimum": 1, "maximum": 4, "owner": "identity_owner", "evidence_gate": "G-OPERATIONS"},
    "jwks_freshness": {"value": 300, "unit": "seconds", "minimum": 0, "maximum": 300, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "delivery_connect": {"value": 500, "unit": "milliseconds", "minimum": 100, "maximum": 1000, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "delivery_read": {"value": 3000, "unit": "milliseconds", "minimum": 250, "maximum": 5000, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "delivery_attempt": {"value": 4000, "unit": "milliseconds", "minimum": 1000, "maximum": 6000, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "delivery_calls_per_worker": {"value": 1, "unit": "calls", "minimum": 1, "maximum": 2, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "outbox_lease": {"value": 30, "unit": "seconds", "minimum": 10, "maximum": 120, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "outbox_claim_batch": {"value": 10, "unit": "rows", "minimum": 1, "maximum": 10, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "outbox_attempts_per_generation": {"value": 8, "unit": "attempts_including_initial", "minimum": 1, "maximum": 8, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "outbox_generation_horizon": {"value": 1800, "unit": "seconds", "minimum": 60, "maximum": 1800, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "delivery_backoff_base": {"value": 5, "unit": "seconds", "minimum": 1, "maximum": 30, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "delivery_backoff_cap": {"value": 900, "unit": "seconds", "minimum": 5, "maximum": 900, "owner": "delivery_owner", "evidence_gate": "G-OPERATIONS"},
    "delivery_ciphertext_purge": {"value": 3600, "unit": "seconds_after_delivery_or_expiry", "minimum": 60, "maximum": 3600, "owner": "security_owner", "evidence_gate": "G-OPERATIONS"},
    "database_attempts": {"value": 2, "unit": "attempts_including_initial", "minimum": 1, "maximum": 2, "owner": "engineering_lead", "evidence_gate": "G-DATABASE"},
    "database_retry_base": {"value": 25, "unit": "milliseconds", "minimum": 1, "maximum": 50, "owner": "engineering_lead", "evidence_gate": "G-DATABASE"},
    "database_retry_cap": {"value": 100, "unit": "milliseconds", "minimum": 25, "maximum": 100, "owner": "engineering_lead", "evidence_gate": "G-DATABASE"},
    "successful_receipt_retention": {"value": 86400, "unit": "seconds", "minimum": 86400, "maximum": 604800, "owner": "engineering_lead", "evidence_gate": "G-DOMAIN"},
    "session_maximum_lifetime": {"value": 28800, "unit": "seconds", "minimum": 900, "maximum": 28800, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "session_idle_bound": {"value": 1800, "unit": "seconds", "minimum": 60, "maximum": 1800, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "sensitive_authentication_age": {"value": 900, "unit": "seconds", "minimum": 60, "maximum": 900, "owner": "identity_owner", "evidence_gate": "G-IDENTITY"},
    "readiness_probe": {"value": 1000, "unit": "milliseconds", "minimum": 100, "maximum": 1000, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS"},
    "http_drain": {"value": 30, "unit": "seconds", "minimum": 5, "maximum": 30, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS"},
    "supervisor_termination_grace": {"value": 40, "unit": "seconds", "minimum": 10, "maximum": 60, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS"},
    "recovery_point_objective": {"value": 300, "unit": "seconds", "minimum": 0, "maximum": 300, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS", "measurement_status": "unverified_live_objective"},
    "recovery_time_objective": {"value": 3600, "unit": "seconds", "minimum": 60, "maximum": 3600, "owner": "platform_owner", "evidence_gate": "G-OPERATIONS", "measurement_status": "unverified_live_objective"}
  },
  "circuit_breakers": [
    {"dependency": "oidc", "owner": "identity_owner", "window_seconds": 30, "minimum_samples": 20, "failure_ratio": 0.5, "open_seconds": 30, "half_open_max_calls": 1, "fallback": "current verified local session and current primary access only; new authentication denied when unverifiable"},
    {"dependency": "delivery", "owner": "delivery_owner", "window_seconds": 30, "minimum_samples": 20, "failure_ratio": 0.5, "open_seconds": 60, "half_open_max_calls": 1, "fallback": "bounded pending retry or terminal failed; no fabricated delivery success"}
  ],
  "retry_protocol": {
    "single_owner_per_logical_operation": true,
    "jitter": "uniform_full_jitter",
    "database_retryable_conditions": ["deadlock_detected", "serialization_failure", "known_rolled_back_transient_read"],
    "oidc_token_exchange_total_attempts": 1,
    "oidc_read_total_attempts": 2,
    "never_retry": ["policy_denial", "expired_session", "stale_version_as_new", "new_key_after_uncertain_commit", "consumed_invitation_with_new_key"],
    "receipt_scope": ["actor", "organization", "operation", "route_target", "canonical_request_hash", "expected_version"],
    "raw_secret_payload_storage": false,
    "reconcile_after_receipt_expiry": true
  },
  "outbox_protocol": {
    "states": ["pending", "delivered", "failed"],
    "leased_is_derived_pending_state": true,
    "delivery_semantics": "at_least_once",
    "exactly_once_claim": false,
    "claim_lock": "FOR UPDATE SKIP LOCKED",
    "claim_size_rule": "min(outbox_claim_batch, currently available delivery slots)",
    "claim_eligibility": ["pending message", "generation attempts below cap", "retry horizon valid", "pending unexpired invitation", "no current lease"],
    "claim_commit_before_network": true,
    "validity_rechecked_before_provider_call": true,
    "exhausted_pending_finalizer": "bounded terminal failure for unleased or expired-lease work; never steal current lease",
    "outcome_cas": ["lease_owner", "lease_token", "unexpired_lease"],
    "claim_increments": ["attempts", "generation_attempts"],
    "requeue_preconditions": ["authorized review", "existing readable ciphertext", "pending unexpired invitation", "same intent and delivery key"],
    "requeue_changes": ["increment replay_generation", "reset generation_attempts", "preserve cumulative attempts", "clear failed and lease metadata", "deadline=min(now+generation_horizon, invitation_expiry)"],
    "terminal_purge": ["state delivered or failed", "encrypted_payload null", "payload_purged_at populated"],
    "provider_deduplication": "requires verified adapter retention; otherwise duplicate delivery remains possible",
    "permanent_error_classes": ["payload_unreadable", "recipient_policy_invalid", "provider_permanent_rejection", "invitation_expired"],
    "transient_error_classes": ["transport_timeout", "provider_rate_limit", "provider_temporarily_unavailable"]
  },
  "authorization_resilience": {
    "data_source": "primary",
    "successful_decision_cache": false,
    "replica_permission_read": false,
    "dependency_failure_result": "unavailable or denied according to canonical response contract; never allow by fallback",
    "known_jwks_only_within_freshness_bound": true,
    "unknown_kid_requires_allowlisted_refresh": true,
    "provider_revocation_event_evicts_immediately": true,
    "remote_provider_revocation_guarantee": "unverified until actual event and session integration is tested",
    "migration_source_outage": "pause affected migration; approved target organizations continue with current primary policy"
  },
  "recovery_protocol": {
    "routine_rollback": "target compatible application artifact only",
    "legacy_authority_rollback": false,
    "externally_durable_prepared_intent_before_access_transaction": true,
    "committed_linkage": "same journal_reference on audit event and command receipt for journal-required live access mutations",
    "outcome_append_after_commit": true,
    "distributed_atomicity_claim": false,
    "journal_outage": "reject journal-required access mutation without changing state",
    "approved_primary_consumption_on_journal_outage": "continues unless an unresolved restore or revocation requires fencing",
    "synthetic_adapter": "restricted ordered file append plus flush and fsync outside disposable database; no host-loss durability claim",
    "uncertain_revocation": "fence affected access until reconciled",
    "uncertain_addition": "do not grant until established",
    "restore_opening_requires": ["current authority and epoch", "journal and receipt reconciliation", "audit continuity", "session revocation verification", "invitation and outbox reconciliation", "no revived revocation"],
    "live_inputs": ["host journal adapter", "acknowledgment durability", "ordering", "retention", "encryption", "backup and PITR mechanism", "measured recovery drill"]
  },
  "validation_rules": [
    "every numeric parameter value must be within its declared inclusive minimum and maximum",
    "database_lock < database_statement <= database_transaction < http_deadline - http_response_reserve",
    "all retries share the original deadline and remaining reserve",
    "oidc_connect + oidc_read <= oidc_exchange < identity_callback_deadline",
    "delivery_connect + delivery_read <= delivery_attempt < outbox_lease * 1000",
    "http_drain < supervisor_termination_grace",
    "session_idle_bound <= session_maximum_lifetime and sensitive_authentication_age <= session_maximum_lifetime",
    "outbox_attempts_per_generation cannot exceed the canonical schema cap of eight",
    "missing owner, unit, bound, gate, or live input evidence is not a passing check"
  ],
  "required_scenarios": [
    "timeout rolls back complete unit of work",
    "pool overload preserves recovery allocation",
    "retry attempts do not multiply across layers",
    "unknown commit resolves through matching receipt",
    "unknown provider key never authenticates",
    "stale key outside bound denied",
    "worker crashes after provider acceptance",
    "stale lease outcome rejected",
    "poison payload isolated and purged",
    "exhausted pending work becomes visible terminal failure",
    "manual replay preserves generation history and same intent",
    "shutdown drains without incomplete success",
    "restore after revocation never reopens unverified access"
  ],
  "evidence_gates": ["G-DATABASE", "G-IDENTITY", "G-PERFORMANCE", "G-SECURITY", "G-OPERATIONS", "G-MIGRATION", "G-RELEASE"]
}
