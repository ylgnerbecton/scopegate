erDiagram
    accTitle: Scopegate complete entity inventory
    accDescr: All 21 domain and supporting tables with selected columns and primary relationships. Canonical SQL owns complete composite keys, provenance references and indexes.
    USERS {
        uuid id PK
        text issuer
        text subject
        text email
    }
    ORGANIZATIONS {
        uuid id PK
        bigint lock_key UK
        text status
        text access_mode
    }
    PROJECTS {
        uuid id PK
        uuid organization_id FK
        text status
    }
    MEMBERSHIPS {
        uuid id PK
        uuid organization_id FK
        uuid user_id FK
        text role
        text status
        text kind
        boolean can_review_migration
        timestamptz expires_at
        bigint access_version
    }
    RESOURCES {
        uuid id PK
        text external_key UK
        bigint catalog_version
        text status
    }
    RESOURCE_LOCALIZATIONS {
        uuid resource_id PK,FK
        text locale PK
        text title
    }
    PROJECT_RESOURCES {
        uuid organization_id PK,FK
        uuid project_id PK,FK
        uuid resource_id PK,FK
        text status
        bigint entitlement_version
    }
    RESOURCE_GRANTS {
        uuid organization_id PK,FK
        uuid membership_id PK,FK
        uuid project_id PK,FK
        uuid resource_id PK,FK
        text state
    }
    INVITATIONS {
        uuid id PK
        uuid organization_id FK
        text recipient_email_normalized
        text role
        text token_hash UK
        text state
        timestamptz expires_at
    }
    INVITATION_RESOURCES {
        uuid organization_id PK,FK
        uuid invitation_id PK,FK
        uuid project_id PK,FK
        uuid resource_id PK,FK
    }
    REPORT_CONFIGS {
        uuid id PK
        uuid organization_id FK
        uuid project_id FK
    }
    REPORT_RESOURCE_REFS {
        uuid organization_id PK,FK
        uuid report_config_id PK,FK
        uuid project_id PK,FK
        uuid resource_id PK,FK
    }
    SESSIONS {
        uuid id PK
        text token_hash UK
        uuid user_id FK
        text verified_email
        boolean email_verified
        timestamptz authenticated_at
        timestamptz claims_verified_at
        timestamptz created_at
        timestamptz last_seen_at
        timestamptz expires_at
    }
    COMMAND_RECEIPTS {
        text actor_key PK
        uuid organization_id PK,FK
        text operation PK
        text idempotency_key PK
        text request_hash
        text journal_reference
        timestamptz expires_at
    }
    AUDIT_EVENTS {
        uuid id PK
        uuid organization_id FK
        text action
        text journal_reference
        timestamptz created_at
    }
    OUTBOX_MESSAGES {
        uuid id PK
        uuid organization_id FK
        uuid invitation_id FK
        text state
        uuid lease_token
        timestamptz lease_expires_at
        bigint replay_generation
        integer generation_attempts
        timestamptz retry_deadline_at
        timestamptz payload_purged_at
    }
    MIGRATION_LEDGER {
        uuid id PK
        uuid run_id FK
        uuid organization_id FK
        text source_kind
        text source_key
        text outcome
    }
    MIGRATION_RUNS {
        uuid id PK
        text snapshot_hash
        text policy_version
        text state
    }

    MIGRATION_CONTROLS {
        uuid organization_id PK,FK
        uuid current_run_id FK
        bigint writer_epoch
        boolean write_fenced
        bigint source_high_watermark
        bigint applied_high_watermark
        text baseline_revision
    }
    MIGRATION_DECISIONS {
        uuid run_id PK,FK
        uuid organization_id PK,FK
        text principal_key PK
        text project_key PK
        text resource_key PK
        text action PK
        boolean baseline_allowed
        boolean target_allowed
    }
    CATALOG_RECEIPTS {
        text actor_key PK
        text external_key PK,FK
        text idempotency_key PK
        text request_hash
        timestamptz expires_at
    }

    USERS ||--o{ MEMBERSHIPS : joins
    USERS ||--o{ SESSIONS : authenticates
    ORGANIZATIONS ||--o{ PROJECTS : owns
