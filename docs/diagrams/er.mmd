    ORGANIZATIONS ||--o{ REPORT_CONFIGS : owns
    ORGANIZATIONS |o--o{ AUDIT_EVENTS : records
    ORGANIZATIONS |o--o{ MIGRATION_LEDGER : maps
    ORGANIZATIONS ||--o{ COMMAND_RECEIPTS : scopes
    MIGRATION_RUNS ||--o{ MIGRATION_LEDGER : checkpoints
    ORGANIZATIONS ||--o| MIGRATION_CONTROLS : controls
    MIGRATION_RUNS |o--o{ MIGRATION_CONTROLS : current_run
    MIGRATION_RUNS ||--o{ MIGRATION_DECISIONS : compares
    ORGANIZATIONS ||--o{ MIGRATION_DECISIONS : scopes
    RESOURCES ||--o{ CATALOG_RECEIPTS : publisher_retry
    PROJECTS ||--o{ PROJECT_RESOURCES : entitles
    RESOURCES ||--o{ PROJECT_RESOURCES : available
    RESOURCES ||--o{ RESOURCE_LOCALIZATIONS : localizes
    MEMBERSHIPS ||--o{ RESOURCE_GRANTS : receives
    PROJECT_RESOURCES ||--o{ RESOURCE_GRANTS : constrains
    INVITATIONS ||--o{ INVITATION_RESOURCES : proposes
    PROJECT_RESOURCES ||--o{ INVITATION_RESOURCES : constrains
    REPORT_CONFIGS ||--o{ REPORT_RESOURCE_REFS : references
    PROJECT_RESOURCES ||--o{ REPORT_RESOURCE_REFS : constrains
    INVITATIONS |o--o{ OUTBOX_MESSAGES : delivers
    ORGANIZATIONS ||--o{ OUTBOX_MESSAGES : scopes

    %% Composite uniqueness: users issuer and subject; memberships organization and user.
    %% Tenant foreign keys include organization even when the diagram displays separate fields.
    %% Staff expiration is required. Resource deletion is restricted. Expired invitations are derived.
    %% All 21 domain/supporting tables are included; selected columns are shown.
    %% Some actor/reviewer provenance edges are omitted for legibility; canonical SQL is complete.
